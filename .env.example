# API service
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Session cookie signing secret. REQUIRED in production — the server refuses to
# start without it when NODE_ENV=production. Use a long random string, e.g.
# `openssl rand -hex 32`. Signed cookies prevent a user from forging their
# `userId` to impersonate another account or gain admin access.
SESSION_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed browser origins for CORS (the storefront
# URL(s)). Leave empty in local dev to reflect any origin; set it in production,
# e.g. CORS_ORIGINS=https://shop.happyfine.co.ke,https://admin.happyfine.co.ke
CORS_ORIGINS=

# How long (minutes) a checkout holds stock before the reservation expires and
# the units free up again. Should comfortably exceed a typical M-Pesa/card
# payment attempt. Defaults to 15 if unset.
STOCK_RESERVATION_TTL_MINUTES=15

# Public URL of the storefront, used to build payment redirect/callback URLs
# (e.g. the Paystack return URL and the Google post-login redirect). No trailing
# slash. Example: https://shop.happyfine.co.ke
STOREFRONT_URL=http://localhost:5173

# ── Payments: M-Pesa (Safaricom Daraja STK Push) ──────────────────────────
# Create a Daraja app at https://developer.safaricom.co.ke. Use "sandbox" while
# testing, then "production" with your Go-Live shortcode/passkey.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace_with_daraja_consumer_key
MPESA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_with_lipa_na_mpesa_passkey
# Public https URL Safaricom calls back. Include the callback token below so the
# webhook can't be spoofed, e.g.
# https://api.happyfine.co.ke/api/payments/mpesa/callback?token=<MPESA_CALLBACK_TOKEN>
MPESA_CALLBACK_URL=https://api.happyfine.co.ke/api/payments/mpesa/callback?token=replace_with_a_long_random_secret

# Shared secret guarding the M-Pesa (Daraja) callback. Must match the ?token=
# value in MPESA_CALLBACK_URL. When set, callbacks without the matching token
# are rejected so no one can mark orders paid by POSTing to the webhook.
MPESA_CALLBACK_TOKEN=replace_with_a_long_random_secret

# ── Payments: Paystack (card / bank) ──────────────────────────────────────
# Keys from https://dashboard.paystack.com/#/settings/developers
# Use the test keys (sk_test_/pk_test_) first, then live keys once verified.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CURRENCY=KES
# Register this webhook URL in the Paystack dashboard (Settings → API & Webhooks):
# https://api.happyfine.co.ke/api/payments/paystack/webhook
# The public key is only needed if you switch to inline (browser) checkout.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# ── Google sign-in (OAuth 2.0) ────────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Add GOOGLE_REDIRECT_URI to the "Authorized redirect URIs" exactly as below.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Transactional email (Resend) ──────────────────────────────────────────
# API key from https://resend.com/api-keys. RESEND_FROM must be a verified
# sender/domain, e.g. "Happyfine <orders@happyfine.co.ke>". Without a key set,
# order/OTP emails are skipped (and OTP codes are returned inline in dev).
RESEND_API_KEY=re_replace_me
RESEND_FROM=Happyfine <onboarding@resend.dev>

# Supabase Postgres.
# For Railway, prefer Supabase's pooler URL and add sslmode=require.
# To enforce RLS for the API role, create app_server from supabase/app_server_role.example.sql
# and use a username like app_server.<project-ref> for Supavisor pooler URLs.
DATABASE_URL=postgres://app_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

# Supabase Storage (product/category images). The API uploads with the
# service-role key server-side and auto-creates a public bucket on first use.
# Find these under Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=media

# Meilisearch. Leave empty locally if you want the API to fall back to Postgres search.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=replace_with_a_long_master_or_search_key
MEILISEARCH_PRODUCTS_INDEX=products

# Storefront Vite service
BASE_PATH=/
VITE_API_BASE_URL=http://localhost:3000
