# API service
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Session cookie signing secret. REQUIRED in production — the server refuses to
# start without it when NODE_ENV=production. Use a long random string, e.g.
# `openssl rand -hex 32`. Signed cookies prevent a user from forging their
# `userId` to impersonate another account or gain admin access.
SESSION_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed browser origins for CORS (the storefront
# URL(s)). Leave empty in local dev to reflect any origin; set it in production,
# e.g. CORS_ORIGINS=https://shop.happyfine.co.ke,https://admin.happyfine.co.ke
CORS_ORIGINS=

# Shared secret guarding the M-Pesa (Daraja) callback. Register the callback URL
# with this token in the query string, e.g.
# https://api.happyfine.co.ke/api/payments/mpesa/callback?token=<this value>
# When set, callbacks without the matching token are rejected so no one can mark
# orders paid by POSTing to the webhook.
MPESA_CALLBACK_TOKEN=replace_with_a_long_random_secret

# Supabase Postgres.
# For Railway, prefer Supabase's pooler URL and add sslmode=require.
# To enforce RLS for the API role, create app_server from supabase/app_server_role.example.sql
# and use a username like app_server.<project-ref> for Supavisor pooler URLs.
DATABASE_URL=postgres://app_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

# Supabase Storage (product/category images). The API uploads with the
# service-role key server-side and auto-creates a public bucket on first use.
# Find these under Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=media

# Meilisearch. Leave empty locally if you want the API to fall back to Postgres search.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=replace_with_a_long_master_or_search_key
MEILISEARCH_PRODUCTS_INDEX=products

# Storefront Vite service
BASE_PATH=/
VITE_API_BASE_URL=http://localhost:3000
